NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exemplo fictício: privacidade@example.com
NEXT_PUBLIC_CONTACT_EMAIL=
# Origem pública da plataforma, como https://classroom.example.com
